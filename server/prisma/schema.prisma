generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  firebaseUid    String       @unique
  email          String       @unique
  name           String?
  avatar         String?
  githubUsername String?
  createdAt      DateTime     @default(now())
  githubToken    String?
  repositories   Repository[]
}

model Repository {
  id String @id @default(cuid())

  githubRepoId Int     @unique
  name         String
  owner        String
  description  String?
  language     String?
  stars        Int     @default(0)

  private Boolean

  repoUrl       String
  defaultBranch String

  userId String

  user User @relation(fields: [userId], references: [id])

  analytics     RepositoryAnalytics?
  techStack     RepositoryTechStack?
  health        RepositoryHealth?
  architecture  RepositoryArchitecture?
  technicalDebt RepositoryTechnicalDebt?
  deployment RepositoryDeployment?

  createdAt DateTime @default(now())
}

model RepositoryAnalytics {
  id              String     @id @default(cuid())
  repositoryId    String     @unique
  stars           Int        @default(0)
  forks           Int        @default(0)
  watchers        Int        @default(0)
  openIssues      Int        @default(0)
  primaryLanguage String?
  languages       Json?
  contributors    Int        @default(0)
  lastCommitDate  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryTechStack {
  id String @id @default(cuid())

  repositoryId String @unique

  technologies Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryHealth {
  id String @id @default(cuid())

  repositoryId String     @unique
  repository   Repository @relation(fields: [repositoryId], references: [id])

  healthScore        Int
  activityScore      Int
  documentationScore Int
  maintenanceScore   Int
  openSourceScore    Int

  recommendations Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepositoryArchitecture {
  id String @id @default(cuid())

  repositoryId String @unique

  graph Json

  nodeCount Int

  edgeCount Int

  complexityScore Int

  hasCircularDependency Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryTechnicalDebt {
  id String @id @default(cuid())

  repositoryId String     @unique
  repository   Repository @relation(fields: [repositoryId], references: [id])

  technicalDebtScore   Int
  maintainabilityScore Int

  largeFileCount           Int @default(0)
  deadFileCount            Int @default(0)
  circularDependencyCount  Int @default(0)
  deepDependencyChainCount Int @default(0)

  largeFiles           Json
  deadFiles            Json
  deepDependencyChains Json

  recommendations Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepositoryDeployment {
  id String @id @default(cuid())

  repositoryId String @unique
  repository Repository @relation(fields: [repositoryId], references: [id])

  deploymentScore Int

  infrastructureScore Int
  configurationScore Int
  buildReadinessScore Int
  ciCdScore Int

  status String

  checks Json

  strengths Json

  warnings Json

  criticalIssues Json

  recommendations Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}