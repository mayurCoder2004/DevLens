generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  firebaseUid    String   @unique
  email          String   @unique
  name           String?
  avatar         String?
  githubUsername String?
  createdAt      DateTime @default(now())
  githubToken    String?

  repositories Repository[]
  activities   Activity[]
}

model Repository {
  id              String    @id @default(cuid())
  githubRepoId    Int       @unique
  name            String
  owner           String
  description     String?
  language        String?
  stars           Int       @default(0)
  private         Boolean
  repoUrl         String
  defaultBranch   String
  userId          String
  createdAt       DateTime  @default(now())
  updatedAtGithub DateTime?

  pullRequestAnalyses PullRequestAnalysis[]
  user                User                  @relation(fields: [userId], references: [id])

  aiReview      RepositoryAIReview?
  analytics     RepositoryAnalytics?
  architecture  RepositoryArchitecture?
  deployment    RepositoryDeployment?
  health        RepositoryHealth?
  techStack     RepositoryTechStack?
  technicalDebt RepositoryTechnicalDebt?

  activities Activity[]
}

model RepositoryAnalytics {
  id              String     @id @default(cuid())
  repositoryId    String     @unique
  stars           Int        @default(0)
  forks           Int        @default(0)
  watchers        Int        @default(0)
  openIssues      Int        @default(0)
  primaryLanguage String?
  languages       Json?
  contributors    Int        @default(0)
  lastCommitDate  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryTechStack {
  id           String     @id @default(cuid())
  repositoryId String     @unique
  technologies Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryHealth {
  id                 String     @id @default(cuid())
  repositoryId       String     @unique
  healthScore        Int
  activityScore      Int
  documentationScore Int
  maintenanceScore   Int
  openSourceScore    Int
  recommendations    Json
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  repository         Repository @relation(fields: [repositoryId], references: [id])
}

model RepositoryArchitecture {
  id                    String     @id @default(cuid())
  repositoryId          String     @unique
  graph                 Json
  nodeCount             Int
  edgeCount             Int
  complexityScore       Int
  hasCircularDependency Boolean
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  repository            Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model RepositoryTechnicalDebt {
  id                       String     @id @default(cuid())
  repositoryId             String     @unique
  technicalDebtScore       Int
  maintainabilityScore     Int
  largeFileCount           Int        @default(0)
  deadFileCount            Int        @default(0)
  circularDependencyCount  Int        @default(0)
  deepDependencyChainCount Int        @default(0)
  largeFiles               Json
  deadFiles                Json
  deepDependencyChains     Json
  recommendations          Json
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  repository               Repository @relation(fields: [repositoryId], references: [id])
}

model RepositoryDeployment {
  id                  String     @id @default(cuid())
  repositoryId        String     @unique
  deploymentScore     Int
  infrastructureScore Int
  configurationScore  Int
  buildReadinessScore Int
  ciCdScore           Int
  strengths           Json
  warnings            Json
  criticalIssues      Json
  recommendations     Json
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deploymentStatus    String
  dockerQuality       Json?
  lockFiles           Json?
  platforms           Json?
  runtime             Json?
  workflowQuality     Json?
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model PullRequestAnalysis {
  id                      String   @id @default(cuid())
  repositoryId            String
  prNumber                Int
  title                   String
  riskScore               Int
  riskLevel               String
  changedFiles            Json
  criticalFiles           Json
  hasDependencyChanges    Boolean  @default(false)
  hasConfigurationChanges Boolean  @default(false)
  recommendations         Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  additions               Int
  deletions               Int
  riskBreakdown           Json
  totalChanges            Int
  totalFiles              Int

  repository   Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  changeImpact ChangeImpactAnalysis?

  @@unique([repositoryId, prNumber])
}

model ChangeImpactAnalysis {
  id                    String   @id @default(cuid())
  pullRequestAnalysisId String   @unique
  score                 Int
  level                 String
  breakdown             Json
  metrics               Json
  affectedFiles         Json
  criticalAffectedFiles Json
  affectedAreas         Json
  recommendations       Json
  unresolvedFiles       Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pullRequestAnalysis PullRequestAnalysis @relation(fields: [pullRequestAnalysisId], references: [id], onDelete: Cascade)
}

model RepositoryAIReview {
  id           String @id @default(cuid())
  repositoryId String @unique

  review        Json
  modelUsed     String?
  promptVersion String? @default("v2")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model Activity {
  id String @id @default(cuid())

  userId       String
  repositoryId String?

  type ActivityType

  title       String
  description String?

  metadata Json?

  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([repositoryId])
}

enum ActivityType {
  REPOSITORY_SYNC
  AI_REVIEW
  ARCHITECTURE
  TECHNICAL_DEBT
  ENGINEERING_HEALTH
  DEPLOYMENT
  PULL_REQUEST
}
